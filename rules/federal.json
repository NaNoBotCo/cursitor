      "days": 21, "unit": "calendar",
      "cite": "FRCP 12(a)(1)(A)(i)",
      "service_extension": false,
      "notes": "Service of the summons is made under Rule 4, so Rule 6(d) adds no days."
    },
    {
      "id": "fed.answer_waiver",
      "label": "Answer after a timely returned waiver of service",
      "direction": "after", "trigger": "the waiver request was sent",
