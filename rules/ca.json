      "label": "Notice of motion to compel further responses (interrogatories, production, admissions)",
      "direction": "after",
      "trigger": "service of the verified response or supplemental response",
      "days": 45,
      "unit": "calendar",
      "cite": "CCP §2030.300(c)",
      "also": [
        "CCP §2031.310(c) (production)",
        "CCP §2033.290(c) (admissions)",
        "CCP §2016.050 (service extensions apply)"
      ],
      "service_extension": true,
      "notes": "The 45 days run from the verified response; an unverified response, or a later written extension agreed by the parties, changes the trigger. A deadline agreed by letter is MOVED only when the confirming writing is on disk."
    },
