#!/usr/bin/env python3
"""Run cursitor from anywhere: bin/cursitor <command>. Add this folder to PATH, or symlink the file."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(here))

from cursitor.cli import main  # noqa: E402

sys.exit(main())
